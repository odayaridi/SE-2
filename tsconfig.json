{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "strict": true,
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./build",
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}